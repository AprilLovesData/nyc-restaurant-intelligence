# ---- Data files: not tracked ----
# The raw inspection extract is 158 MB, over GitHub's 100 MB per-file limit.
# Cleaned outputs are reproducible by running notebook 01.
data/raw/*
data/cleaned/*
data/processed/*
!data/**/.gitkeep
!data/raw/README.md

# Borough outlines are the exception: 2.9 MB of static map geometry that never
# changes and is not in the database (see notebook 04). The dashboard reads it
# from here, so it has to travel with the code.
!data/cleaned/borough_boundaries.csv

# ---- Notebooks ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.env

# ---- OS ----
.DS_Store
.claude/

# Copy this file to secrets.toml and fill in your own values.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
#
# secrets.toml is git-ignored. The anon key is designed to be public — row level
# security in sql/schema.sql restricts it to read-only — but keep it out of the
# repository anyway.

[supabase]
url = "https://YOUR-PROJECT.supabase.co"
anon_key = "YOUR-ANON-KEY"

# Sign-in credentials for the dashboard gate. Any number of users can be listed.
# This controls who can open the page; it does not restrict which rows they see —
# that would require Supabase row level security tied to an authenticated user.
[auth.users]
gateway = "NYC-Market-2026"
